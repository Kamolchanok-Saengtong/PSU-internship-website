# Copy to .env.local and fill in. None are needed for local development.

# Real email sending through Resend (https://resend.com). Without these,
# emails are only saved to the dev outbox at /dev/outbox.
RESEND_API_KEY=
EMAIL_FROM="PSU Phuket Internship Board <noreply@your-domain.example>"

# Public address of the site, used for links in emails.
APP_URL=http://localhost:3000

# Required in production: the daily job must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
